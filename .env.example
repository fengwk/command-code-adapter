CC_ADAPTER_CC_API_KEY=["user_your_key_here","user_another_key"]  # JSON array of CC API keys; optional (the admin panel can add/remove keys at runtime)
CC_ADAPTER_CC_BASE_URL=https://api.commandcode.ai
CC_ADAPTER_HOST=0.0.0.0
CC_ADAPTER_PORT=8080
CC_ADAPTER_LOG_LEVEL=INFO
CC_ADAPTER_LOG_FORMAT=console    # "console" or "json"
CC_ADAPTER_ADMIN_PASSWORD=    # Admin panel password, empty = no login required
CC_ADAPTER_ENV_FILE=.env  # Dotenv file the panel rewrites (keys + configuration) and the service reads back; point it into a mounted *directory* (e.g. /app/data/.env) because the write is an atomic replace, so a single-file bind mount fails with EBUSY
CC_ADAPTER_ACCESS_KEY=sk-your-key  # Access key for /v1/chat/completions, empty = no auth
CC_ADAPTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash  # Default model for playground and verify
CC_ADAPTER_OSS_PRIMARY_PROVIDER=  # Optional OSS provider name (e.g. "deepseek"), sent as x-oss-primary-provider header
CC_ADAPTER_KEY_COOLDOWN_BASE=60      # Rate-limit (429) cooldown start in seconds, doubles per failure
CC_ADAPTER_KEY_COOLDOWN_MAX=1800     # Rate-limit cooldown cap in seconds
CC_ADAPTER_KEY_CREDIT_COOLDOWN=1800  # Flat cooldown for an out-of-credits key, in seconds
